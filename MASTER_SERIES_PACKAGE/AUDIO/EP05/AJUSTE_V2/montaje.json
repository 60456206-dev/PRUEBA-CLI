      "end": 2.198,
      "text": "Me dijiste que habías comprobado."
    },
    {
      "id": "L02",
      "shot": 2,
      "start": 4.25,
      "end": 8.518,
      "text": "Y yo firmé. Sin mirar. Me acuerdo."
    },
    {
