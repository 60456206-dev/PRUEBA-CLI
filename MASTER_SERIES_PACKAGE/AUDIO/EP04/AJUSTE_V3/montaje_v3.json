      "end": 7.155,
      "text": "El agua iba hacia la sala norte.\\NTú estabas allí.",
      "style": "Default"
    },
    {
      "id": "L02",
      "start": 8.45,
      "end": 10.865,
      "text": "Cerré para que\\Nno te alcanzara.",
      "style": "Default"
    },
    {
      "id": "L03",
      "start": 12.75,
      "end": 14.967,
      "text": "¿Sabías que Mara\\Nseguía dentro?",
      "style": "Default"
    },
    {
      "id": "L04",
      "start": 17.3,
      "end": 18.097,
      "text": "Sí.",
      "style": "Default"
    },
    {
      "id": "L05",
      "start": 20.15,
      "end": 22.404,
      "text": "No podía perderos\\Na las dos.",
      "style": "Default"
    },
    {
      "id": "L06",
      "start": 23.25,
      "end": 25.951,
      "text": "La perdiste tú.\\NA mí me mentiste.",
      "style": "Default"
    },
    {
