  "dialogue": [
    {
      "id": "L01",
      "shot": 2,
      "start": 4.2,
      "end": 8.555,
      "text": "El agua iba hacia la sala norte. Tú estabas allí."
    },
    {
      "id": "L02",
      "shot": 3,
      "start": 10.25,
      "end": 12.665,
      "text": "Cerré para que no te alcanzara."
    },
    {
      "id": "L03",
      "shot": 4,
      "start": 15.05,
      "end": 17.267,
      "text": "¿Sabías que Mara seguía dentro?"
    },
    {
      "id": "L04",
      "shot": 5,
      "start": 20.15,
      "end": 20.947,
      "text": "Sí."
    },
    {
      "id": "L05",
      "shot": 6,
      "start": 23.25,
      "end": 25.504,
      "text": "No podía perderos a las dos."
    },
    {
      "id": "L06",
      "shot": 6,
      "start": 26.55,
      "end": 29.251,
      "text": "La perdiste tú. A mí me mentiste."
    },
    {
      "id": "L07",
      "shot": 8,
      "start": 34.55,
      "end": 38.39,
      "text": "Yo cerré la puerta. Tú firmaste que no quedaba nadie."
    }
  ],
