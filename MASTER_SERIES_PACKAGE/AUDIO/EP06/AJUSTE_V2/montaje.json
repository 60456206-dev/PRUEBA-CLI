      "start": 0.45,
      "end": 5.968,
      "text": "Elena Ríos. Tomás Vera. Luz Arce. Bruno Sol."
    },
    {
      "id": "L02",
      "shot": 2,
      "start": 7.25,
      "end": 12.511,
      "text": "Celia Paz. Samuel Costa. Y yo, Mara Vidal."
    },
    {
      "id": "L03",
      "shot": 3,
      "start": 13.5,
      "end": 17.315,
      "text": "Firmé sin comprobar. Adjuntaré mi declaración."
    },
    {
      "id": "L04",
      "shot": 4,
      "start": 18.9,
      "end": 20.967,
      "text": "No voy a quitar tu nombre."
    },
    {
      "id": "L05",
      "shot": 6,
      "start": 28.15,
      "end": 31.354,
      "text": "Deja el mío también. ¿Puedo quedarme?"
    },
    {
      "id": "L06",
      "shot": 7,
      "start": 34.55,
      "end": 36.798,
      "text": "Y yo, Mara Vidal."
    },
    {
      "id": "L07",
      "shot": 8,
