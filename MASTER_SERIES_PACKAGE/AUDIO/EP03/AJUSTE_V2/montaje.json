  "dialogue": [
    {
      "id": "L01",
      "shot": 2,
      "start": 4.05,
      "end": 6.85,
      "text": "¿Por qué guardabas la llave de la compuerta?"
    },
    {
      "id": "L02",
      "shot": 3,
      "start": 9.0,
      "end": 12.44,
      "text": "Yo llevaba las llaves. Eso ya lo sabes."
    },
    {
      "id": "L03",
      "shot": 4,
      "start": 13.8,
      "end": 16.317,
      "text": "No busques solo mi nombre."
    },
    {
      "id": "L04",
      "shot": 6,
      "start": 22.3,
      "end": 26.487,
      "text": "Mamá. Te oigo al otro lado. Abre."
    },
    {
      "id": "L05",
      "shot": 8,
      "start": 32.35,
      "end": 33.842,
      "text": "La oíste."
    },
    {
      "id": "L06",
      "shot": 8,
      "start": 34.95,
      "end": 35.932,
      "text": "Y no abriste."
    }
  ],
